<Window x:Class="Etssd.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="etssd" Width="780" Height="560">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Run" Width="80" Command="{Binding InferCommand}" />
            <Button Content="Stop" Width="80" Margin="8,0,0,0" Command="{Binding InferCancelCommand}" />
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="依赖检查">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Top" Content="重新检查" Width="100" HorizontalAlignment="Left"
                            Margin="0,0,0,8" Command="{Binding RunChecksCommand}" />
                    <ListView ItemsSource="{Binding Checks}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="90" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="状态" Width="80" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="说明" Width="320" DisplayMemberBinding="{Binding Message}" />
                                <GridViewColumn Header="链接" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Hyperlink NavigateUri="{Binding Link}" RequestNavigate="Link_RequestNavigate">
                                                    <Run Text="{Binding Link, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem Header="日志">
                <ListBox x:Name="LogList" Margin="8" ItemsSource="{Binding Logs}"
                         FontFamily="Consolas" VirtualizingPanel.IsVirtualizing="True" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
