<Page x:Class="Etssd.Gui.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:gui="clr-namespace:Etssd.Gui"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance gui:MainViewModel, IsDesignTimeCreatable=False}"
      Title="设置">
    <Page.Resources>
        <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource CardRow}">
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,24,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <TextBlock Style="{StaticResource SectionHeader}" Margin="4,0,4,8" Text="模型" />
        <ui:Card Padding="0">
            <StackPanel>
                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                    <DockPanel>
                        <ui:TextBox DockPanel.Dock="Right" Width="360" VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFont}" FontSize="13"
                                    ClearButtonEnabled="False"
                                    PlaceholderText="owner/name"
                                    Text="{Binding ModelRepo}" />
                        <StackPanel Style="{StaticResource SettingLabel}">
                            <TextBlock Text="来源仓库" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="Hugging Face 上的模型仓库，普通用户保持默认" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ui:TextBox DockPanel.Dock="Right" Width="360" VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFont}" FontSize="13"
                                    ClearButtonEnabled="False"
                                    PlaceholderText="main"
                                    Text="{Binding ModelRevision}" />
                        <StackPanel Style="{StaticResource SettingLabel}">
                            <TextBlock Text="版本" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="分支、标签或 commit，留空为 main。启动时检查并自动下载" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="360" VerticalAlignment="Center"
                                  ItemsSource="{Binding Mirrors}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedMirror}" />
                        <StackPanel Style="{StaticResource SettingLabel}">
                            <TextBlock Text="镜像站点" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="国内网络可选 hf-mirror.com" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ui:Card>

        <TextBlock Style="{StaticResource SectionHeader}" Margin="4,20,4,8" Text="存储" />
        <ui:Card Padding="0">
            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="打开"
                               Icon="{ui:SymbolIcon Folder24}" Command="{Binding OpenDataDirCommand}" />
                    <StackPanel Style="{StaticResource SettingLabel}">
                        <TextBlock Text="数据目录" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}">
                            <Run FontFamily="{StaticResource MonoFont}" Text="{Binding DataDir, Mode=OneWay}" /><Run Text=" · 模型缓存 models\ · 日志 logs\ · 配置 config.toml" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </ui:Card>
    </StackPanel>
</Page>
