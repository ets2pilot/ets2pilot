<!-- GUI 展示给用户的全部文案。带 {0} 的条目由 Strings.Format 填充。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="Text.App.Title">etssd</sys:String>

    <sys:String x:Key="Text.Nav.Overview">概览</sys:String>
    <sys:String x:Key="Text.Nav.Logs">日志</sys:String>
    <sys:String x:Key="Text.Nav.Settings">设置</sys:String>

    <sys:String x:Key="Text.Status.Bridge">bridge</sys:String>
    <sys:String x:Key="Text.Status.Control">control</sys:String>
    <sys:String x:Key="Text.Status.Model">模型</sys:String>
    <sys:String x:Key="Text.Status.Callbacks">已注册回调：</sys:String>
    <sys:String x:Key="Text.Status.NoCallbacks">无</sys:String>

    <sys:String x:Key="Text.Overview.TitleRunning">模型运行中</sys:String>
    <sys:String x:Key="Text.Overview.TitleReady">就绪</sys:String>
    <sys:String x:Key="Text.Overview.TitleNotReady">尚未就绪</sys:String>
    <!-- {0} 模型名 {1} 版本 {2} 运行时长 {3} 丢帧数 -->
    <sys:String x:Key="Text.Overview.SubtitleRunning">{0} {1} · 已运行 {2} · 丢帧 {3}</sys:String>
    <sys:String x:Key="Text.Overview.SubtitleReady">运行模型后回到游戏，按 W 开启自动驾驶</sys:String>
    <sys:String x:Key="Text.Overview.SubtitleNotReady">先完成标红的准备项</sys:String>
    <sys:String x:Key="Text.Overview.AutopilotOff">自动驾驶 · 关</sys:String>
    <sys:String x:Key="Text.Overview.AutopilotOn">自动驾驶 · 开</sys:String>
    <sys:String x:Key="Text.Overview.Run">运行模型</sys:String>
    <sys:String x:Key="Text.Overview.Stop">停止</sys:String>
    <sys:String x:Key="Text.Overview.ChecksHeader">准备情况</sys:String>
    <sys:String x:Key="Text.Overview.Recheck">重新检查</sys:String>
    <sys:String x:Key="Text.Overview.ModelRow">模型</sys:String>
    <sys:String x:Key="Text.Overview.CheckUpdate">检查更新</sys:String>
    <sys:String x:Key="Text.Overview.Cancel">取消</sys:String>

    <sys:String x:Key="Text.Keys.Lock">锁定/解锁手动驾驶</sys:String>
    <sys:String x:Key="Text.Keys.LockTip">锁定手动驾驶后，W/S 不会快捷切换自动驾驶</sys:String>
    <sys:String x:Key="Text.Keys.Engage">开启自动驾驶</sys:String>
    <!-- {0} 长按秒数 -->
    <sys:String x:Key="Text.Keys.Disengage">长按 {0:0.#} 秒关闭自动驾驶</sys:String>

    <sys:String x:Key="Text.Check.VJoy">vJoy</sys:String>
    <sys:String x:Key="Text.Check.VJoyLink">下载 vJoy</sys:String>
    <sys:String x:Key="Text.Check.Game">游戏</sys:String>
    <sys:String x:Key="Text.Check.Telemetry">遥测插件</sys:String>
    <sys:String x:Key="Text.Check.TelemetryLink">下载插件</sys:String>
    <sys:String x:Key="Text.Check.Gpu">显卡</sys:String>
    <sys:String x:Key="Text.Check.Ep">TensorRT-RTX EP</sys:String>
    <sys:String x:Key="Text.Check.EpLink">下载驱动</sys:String>
    <sys:String x:Key="Text.Check.DefaultLink">下载</sys:String>
    <sys:String x:Key="Text.Check.Benchmark">推理耗时</sys:String>

    <sys:String x:Key="Text.Benchmark.Run">测试</sys:String>
    <sys:String x:Key="Text.Benchmark.NotRun">未测试</sys:String>
    <sys:String x:Key="Text.Benchmark.Running">正在测试</sys:String>

    <sys:String x:Key="Text.Model.Unchecked">未检查</sys:String>
    <sys:String x:Key="Text.Model.Checking">正在检查 {0}</sys:String>
    <!-- {0} 版本 {1} 文件名 {2} 已下载 MB {3} 总计 MB {4} 速度 MB/s -->
    <sys:String x:Key="Text.Model.Downloading">正在下载 {0} · {1} · {2:0} / {3} MB · {4:0.0} MB/s</sys:String>
    <!-- {0} 模型名 {1} 版本 {2} 未能检查更新的原因 -->
    <sys:String x:Key="Text.Model.Cached">{0} · {1} · 使用缓存，未能检查更新：{2}</sys:String>
    <!-- {0} 模型名 {1} 版本 {2} 远端最后修改时间 -->
    <sys:String x:Key="Text.Model.LatestAt">{0} · {1} · 已是最新（{2:yyyy-MM-dd}）</sys:String>
    <sys:String x:Key="Text.Model.Latest">{0} · {1} · 已是最新</sys:String>

    <sys:String x:Key="Text.Logs.OpenFile">打开日志文件</sys:String>
    <sys:String x:Key="Text.Logs.OpenDir">打开日志目录</sys:String>
    <sys:String x:Key="Text.Logs.AutoScroll">自动滚动</sys:String>
    <sys:String x:Key="Text.Logs.Retention">窗口内保留最近 {0} 行</sys:String>
    <sys:String x:Key="Text.Logs.FilePrefix">文件：</sys:String>
    <sys:String x:Key="Text.Logs.FileHint">反馈问题时直接发送此文件</sys:String>

    <sys:String x:Key="Text.Settings.ModelHeader">模型</sys:String>
    <sys:String x:Key="Text.Settings.Repo">来源仓库</sys:String>
    <sys:String x:Key="Text.Settings.RepoHint">Hugging Face 上的模型仓库，普通用户保持默认</sys:String>
    <sys:String x:Key="Text.Settings.RepoPlaceholder">owner/name</sys:String>
    <sys:String x:Key="Text.Settings.Revision">版本</sys:String>
    <sys:String x:Key="Text.Settings.RevisionHint">分支、标签或 commit，留空为 main。启动时检查并自动下载</sys:String>
    <sys:String x:Key="Text.Settings.RevisionPlaceholder">main</sys:String>
    <sys:String x:Key="Text.Settings.Mirror">镜像站点</sys:String>
    <sys:String x:Key="Text.Settings.MirrorHint">国内网络可选 hf-mirror.com</sys:String>
    <sys:String x:Key="Text.Settings.MirrorDirect">直连 huggingface.co</sys:String>
    <sys:String x:Key="Text.Settings.StorageHeader">存储</sys:String>
    <sys:String x:Key="Text.Settings.DataDir">数据目录</sys:String>
    <sys:String x:Key="Text.Settings.DataDirHint">模型缓存 models\ · 日志 logs\ · 配置 config.toml</sys:String>
    <sys:String x:Key="Text.Settings.Open">打开</sys:String>

</ResourceDictionary>
