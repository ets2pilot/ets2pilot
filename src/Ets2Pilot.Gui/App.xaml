<Application x:Class="Ets2Pilot.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Strings.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

            <!-- Tag 绑定 ReadinessStatus -->
            <Style x:Key="StatusIcon" TargetType="ui:SymbolIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Filled" Value="True" />
                <Setter Property="Symbol" Value="Circle24" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Ok">
                        <Setter Property="Symbol" Value="CheckmarkCircle24" />
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warning">
                        <Setter Property="Symbol" Value="Warning24" />
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Failed">
                        <Setter Property="Symbol" Value="DismissCircle24" />
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Busy">
                        <Setter Property="Symbol" Value="Clock24" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- 卡片内除第一行外的行，顶部分隔线 -->
            <Style x:Key="CardRow" TargetType="Border">
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="MinHeight" Value="48" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
